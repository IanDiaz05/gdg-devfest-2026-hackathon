FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
# Import is ../../../backend/data/ciudades.json from /app/src/services.
COPY backend/data/ciudades.json /backend/data/ciudades.json

# Client paths already include /api. An empty base keeps requests same-origin for nginx.
ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

FROM nginx:1.30.7-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

# nginx:1.30.7-alpine ships curl, not wget. The compose healthcheck calls wget.
# PID moves to /tmp and logs move to stdio so a non-root process can start
# with a read-only root filesystem.
RUN apk add --no-cache wget \
    && sed -i \
        -e 's|/var/run/nginx.pid|/tmp/nginx.pid|g' \
        -e 's|/var/log/nginx/error.log|/dev/stderr|g' \
        -e 's|/var/log/nginx/access.log|/dev/stdout|g' \
        /etc/nginx/nginx.conf \
    && chown -R nginx:nginx /var/cache/nginx /var/log/nginx /etc/nginx/conf.d /usr/share/nginx/html

USER nginx

EXPOSE 8080
